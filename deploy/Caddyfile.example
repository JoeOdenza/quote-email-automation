# Caddy site block for mailing.odenzamarketing.com. Replace the server's block
# for this domain with it (keep the server's own tls line), then check and
# reload:
#
#   sudo -u caddy caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
#   /                → landing page (deploy/landing/index.html)
#   /travel/quote/*  → this app (quote emails), port 3100
#   /sales/mail/*    → the sales mailing app, port 3000
#
# Both apps are built with their path as a Next.js basePath and expect it in
# every request, so they use "handle", which passes the path on unchanged
# ("handle_path" would strip it and break them).

mailing.odenzamarketing.com {
	tls /etc/caddy/certs/mailing.crt /etc/caddy/certs/mailing.key
	encode gzip zstd

	handle /travel/quote* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /sales/mail* {
		reverse_proxy 127.0.0.1:3000
	}

	# Everything else: the landing page. Copy deploy/landing/ to the server:
	#   sudo mkdir -p /var/www/landing
	#   sudo cp deploy/landing/index.html /var/www/landing/
	handle {
		root * /var/www/landing
		try_files {path} /index.html
		file_server
	}
}
