# Microsoft sign-in and Outlook drafts (Microsoft Graph)
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=paste-the-secret-value-here
MICROSOFT_TENANT=common

# The address the app runs at, including the /travel/quote base path. The
# redirect URI is built from it: <APP_URL>/auth/callback.
# Production: APP_URL=https://mailing.odenzamarketing.com/travel/quote
APP_URL=http://localhost:3000/travel/quote

# Random key that protects sign-in sessions and stored Microsoft tokens.
SESSION_SECRET=paste-a-generated-value-here
