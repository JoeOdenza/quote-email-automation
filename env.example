# Microsoft sign-in and Outlook drafts (Microsoft Graph)
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=paste-the-secret-value-here
MICROSOFT_TENANT=common

# The address the app runs at. The redirect URI is built from it.
APP_URL=http://localhost:3000

# Random key that protects sign-in sessions and stored Microsoft tokens.
SESSION_SECRET=paste-a-generated-value-here
